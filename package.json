{
  "name": "pi-inspector",
  "version": "0.1.3",
  "description": "Inspect the current pi session: live system prompt and full transcript dashboard in the browser",
  "keywords": [
    "debug",
    "extension",
    "inspect",
    "pi",
    "pi-coding-agent",
    "pi-package"
  ],
  "homepage": "https://github.com/link-duan/pi-inspector#readme",
  "bugs": {
    "url": "https://github.com/link-duan/pi-inspector/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-duan/pi-inspector.git"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.html",
    "src/**/*.css",
    "src/web/dist/**",
    "scripts/build-web.mjs",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "postinstall": "npm run build:web",
    "prepack": "npm run build:web",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run build:web && npm test && npm run typecheck && npm run lint && npm run format:check",
    "dev:web": "node scripts/build-web.mjs --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/link-duan/pi-inspector/main/assets/pi-inspect-example.png"
  }
}
